# A raiz do repositório contém somente os quatro módulos e estes arquivos de controle.
/*
!/.gitignore
!/README.md
!/PIPELINE.md
!/raspberry/
!/server/
!/webApp/

# Dependências e artefatos locais de desenvolvimento
**/.venv/
**/venv/
**/node_modules/
**/.next/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example

# Dados gerados durante captura e execução; as matrizes de calibração
# alignment/alignment.npy e raspberry/alignment.npy permanecem versionadas.
/raspberry/data/

# Dados do módulo simulado (server/tools/mock_module.py)
/server/tools/.mock_data/
