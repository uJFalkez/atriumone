# A raiz contém só os módulos versionados e estes arquivos; o resto
# (dados de missões, logs, exports, ambientes) fica local.
/*
!/.gitignore
!/README.md
!/PIPELINE.md
!/server/
!/webApp/

# Dependências e artefatos de desenvolvimento
**/.venv/
**/venv/
**/node_modules/
**/.next/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example

# Dados do módulo simulado (server/tools/mock_module.py)
/server/tools/.mock_data/
