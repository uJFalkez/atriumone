# Versionados na raiz: module/ (Raspberry Pi), server/ (estação: API e
# processamento), webApp/ (dashboard) e este README.
/*
!/.gitignore
!/README.md
!/module/
!/server/
!/webApp/

# Dependências e artefatos de desenvolvimento
**/.venv/
**/venv/
**/node_modules/
**/.next/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example

# Dados do módulo simulado (server/tools/mock_module.py)
/server/tools/.mock_data/
